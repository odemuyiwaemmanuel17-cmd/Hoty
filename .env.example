# Firebase (optional). Without these the customer site runs in clearly-labelled
# DEMO mode and the /admin dashboard shows a setup screen (no fake data).
# Copy your project's web app config here. These are PUBLIC client values —
# the web apiKey is a client identifier, not a secret. Security lives in
# firestore.rules / storage.rules / Cloud Functions. NEVER put a
# service-account key or Firebase Admin credential in frontend code or here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Backend mode (only matters when the config above is set):
#   rules-only  (default) — works on the free Spark plan. Orders are stored
#                 as unverified 'pending review' drafts; Firestore rules
#                 enforce admin rights and status transitions.
#   functions   — requires the Blaze plan + deployed Cloud Functions
#                 (functions/): server-recomputed prices and verified orders.
# VITE_BACKEND_MODE=rules-only
